import os
import time
import re
import datetime

os.environ['TZ'] = 'Asia/Shanghai'
time.tzset()

class CombinedRecipe(BasicNewsRecipe):
    title = datetime.datetime.now().strftime('新闻合辑 - %Y-%m-%d %H-%M')
    language = 'zh_CN'
    oldest_article = 1
    max_articles_per_feed = 10
    
    # 关键：直接使用 RSS 的 description，不抓网页
    use_embedded_content = True
    no_summaries = True
    
    # 清理垃圾标签
    remove_tags = [
        dict(name='hr'),
        dict(name='a', attrs={'href': re.compile(r'.*feedx.*')}),
        dict(name='script'),
        dict(name='style'),
    ]
    
    def preprocess_html(self, soup):
        for a in soup.find_all('a'):
            if 'feedx' in a.get('href', ''):
                a.decompose()
        for div in soup.find_all('div'):
            if '获取更多RSS' in div.get_text():
                div.decompose()
        return soup
    
    # 合并日经和 BBC
    feeds = [
        ('日经中文', 'https://feedx.net/rss/nikkei.xml'),
        ('BBC中文', 'https://feedx.net/rss/bbc.xml'),
    ]
